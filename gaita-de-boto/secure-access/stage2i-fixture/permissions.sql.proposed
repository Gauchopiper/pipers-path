-- INACTIVE REVIEW PROPOSAL ONLY. No SQL here was installed on a native server.
-- Bootstrap only a NEW dedicated Dummy database, never an operational/shared DB.
-- A privileged provisioner must supply reviewed db_name and native-review approval.
\set ON_ERROR_STOP on
\if :{?db_name}
\else
  \echo 'db_name must identify a separately approved dedicated disposable Dummy database'
  \quit
\endif
\connect :db_name
-- Deliberate deployment interlock. This proposal is not an installable runtime DAL.
DO $$ BEGIN RAISE EXCEPTION 'component-native-review-required'; END $$;

-- The following object plan is for line-by-line review. Do NOT remove the interlock
-- until native LOGIN/ACL tests and all stored-procedure bodies are approved.
CREATE ROLE gdbi_owner NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;
CREATE ROLE gdbi_gateway_login LOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;
CREATE ROLE gdbi_worker_login LOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;
CREATE ROLE gdbi_reader_login LOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;
CREATE ROLE gdbi_admission_login LOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;
CREATE ROLE gdbi_recovery_login LOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;
CREATE ROLE gdbi_verifier_login LOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;
CREATE ROLE gdbi_coordinator_login LOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;
CREATE ROLE gdbi_migration_login LOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;
CREATE ROLE gdbi_backup_login LOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;
-- No password, token, role membership or credential is generated by this proposal.
-- Native auth must use separately approved TLS/SCRAM or client certificates.

REVOKE ALL ON DATABASE :"db_name" FROM PUBLIC;
GRANT CONNECT ON DATABASE :"db_name" TO gdbi_gateway_login,gdbi_worker_login,gdbi_reader_login,
 gdbi_admission_login,gdbi_recovery_login,gdbi_verifier_login,gdbi_coordinator_login,gdbi_migration_login,gdbi_backup_login;
REVOKE CREATE ON SCHEMA public FROM PUBLIC;
CREATE SCHEMA gdbi AUTHORIZATION gdbi_owner;
REVOKE ALL ON SCHEMA gdbi FROM PUBLIC;
GRANT USAGE ON SCHEMA gdbi TO gdbi_gateway_login,gdbi_worker_login,gdbi_reader_login,
 gdbi_admission_login,gdbi_recovery_login,gdbi_verifier_login,gdbi_coordinator_login,gdbi_backup_login;
GRANT gdbi_owner TO gdbi_migration_login; -- NOINHERIT; explicit SET ROLE for reviewed migrations only.
ALTER DEFAULT PRIVILEGES FOR ROLE gdbi_owner IN SCHEMA gdbi REVOKE ALL ON TABLES FROM PUBLIC;
ALTER DEFAULT PRIVILEGES FOR ROLE gdbi_owner IN SCHEMA gdbi REVOKE ALL ON SEQUENCES FROM PUBLIC;
ALTER DEFAULT PRIVILEGES FOR ROLE gdbi_owner IN SCHEMA gdbi REVOKE ALL ON FUNCTIONS FROM PUBLIC;

-- Migration step must create/own schema-qualified Stage 2I tables, plus this
-- immutable singleton. Environment foreign keys must reference its sole row.
SET ROLE gdbi_owner;
CREATE TABLE gdbi.binding(singleton boolean PRIMARY KEY DEFAULT true CHECK(singleton),
 environment text UNIQUE NOT NULL,profile_digest text NOT NULL,subject text NOT NULL,pupil text NOT NULL);
-- No runtime grant can insert/update/delete this row. Admission admin cannot rebind it.
-- All gdb_g_* tables below are future migrations, not the current public fixture tables.
-- Existing Stage 2G direct-SQL adapter is NOT authorised for use under these logins.

-- Narrow lock helper solves the FOR UPDATE privilege problem without giving a
-- worker UPDATE on policy. Its return type/body requires the reviewed table migration.
CREATE FUNCTION gdbi.lock_admission() RETURNS SETOF gdbi.gdb_g_admission
 LANGUAGE sql SECURITY DEFINER SET search_path = pg_catalog AS $$
 SELECT a.* FROM gdbi.gdb_g_admission AS a JOIN gdbi.binding AS b USING(environment)
 WHERE b.singleton FOR UPDATE OF a
$$;
CREATE FUNCTION gdbi.lock_revision() RETURNS SETOF gdbi.gdb_g_revision
 LANGUAGE sql SECURITY DEFINER SET search_path = pg_catalog AS $$
 SELECT r.* FROM gdbi.gdb_g_revision AS r JOIN gdbi.binding AS b USING(environment)
 WHERE b.singleton FOR UPDATE OF r
$$;
-- These internal helpers are callable only by reviewed owner-defined entry procedures,
-- not directly by runtime logins. Any procedural call runs inside ONE transaction.

-- Exact allowlisted procedure surface. Bodies intentionally fail closed until the
-- typed argument/state/receipt checks in PERMISSIONS.md are ported and native-tested.
-- All crypto verification happens in a separately authenticated verifier service;
-- no boolean "verified" supplied by a worker/gateway may authorise confirmation.
CREATE FUNCTION gdbi.submit_original(request jsonb) RETURNS jsonb
 LANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog AS $$ BEGIN RAISE EXCEPTION 'component-native-review-required: submit_original'; END $$;
CREATE FUNCTION gdbi.recording_status(request jsonb) RETURNS jsonb
 LANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog AS $$ BEGIN RAISE EXCEPTION 'component-native-review-required: recording_status'; END $$;
CREATE FUNCTION gdbi.claim_recording(request jsonb) RETURNS jsonb
 LANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog AS $$ BEGIN RAISE EXCEPTION 'component-native-review-required: claim_recording'; END $$;
CREATE FUNCTION gdbi.arm_recording(request jsonb) RETURNS jsonb
 LANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog AS $$ BEGIN RAISE EXCEPTION 'component-native-review-required: arm_recording'; END $$;
CREATE FUNCTION gdbi.mark_attention(request jsonb) RETURNS jsonb
 LANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog AS $$ BEGIN RAISE EXCEPTION 'component-native-review-required: mark_attention'; END $$;
CREATE FUNCTION gdbi.confirm_source_receipt(request jsonb) RETURNS jsonb
 LANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog AS $$ BEGIN RAISE EXCEPTION 'component-native-review-required: confirm_source_receipt'; END $$;
CREATE FUNCTION gdbi.set_admission(request jsonb) RETURNS jsonb
 LANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog AS $$ BEGIN RAISE EXCEPTION 'component-native-review-required: set_admission'; END $$;
CREATE FUNCTION gdbi.create_read(request jsonb) RETURNS jsonb
 LANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog AS $$ BEGIN RAISE EXCEPTION 'component-native-review-required: create_read'; END $$;
CREATE FUNCTION gdbi.dispatch_read(request jsonb) RETURNS jsonb
 LANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog AS $$ BEGIN RAISE EXCEPTION 'component-native-review-required: dispatch_read'; END $$;
CREATE FUNCTION gdbi.stage_verified_read(request jsonb) RETURNS jsonb
 LANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog AS $$ BEGIN RAISE EXCEPTION 'component-native-review-required: stage_verified_read'; END $$;
CREATE FUNCTION gdbi.release_read(request jsonb) RETURNS jsonb
 LANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog AS $$ BEGIN RAISE EXCEPTION 'component-native-review-required: release_read'; END $$;
CREATE FUNCTION gdbi.request_reconciliation(request jsonb) RETURNS jsonb
 LANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog AS $$ BEGIN RAISE EXCEPTION 'component-native-review-required: request_reconciliation'; END $$;
CREATE FUNCTION gdbi.begin_revision(request jsonb) RETURNS jsonb
 LANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog AS $$ BEGIN RAISE EXCEPTION 'component-native-review-required: begin_revision'; END $$;
CREATE FUNCTION gdbi.finish_revision(request jsonb) RETURNS jsonb
 LANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog AS $$ BEGIN RAISE EXCEPTION 'component-native-review-required: finish_revision'; END $$;

REVOKE ALL ON ALL TABLES IN SCHEMA gdbi FROM PUBLIC,gdbi_gateway_login,gdbi_worker_login,
 gdbi_reader_login,gdbi_admission_login,gdbi_recovery_login,gdbi_verifier_login,gdbi_coordinator_login;
REVOKE ALL ON ALL SEQUENCES IN SCHEMA gdbi FROM PUBLIC;
REVOKE ALL ON ALL FUNCTIONS IN SCHEMA gdbi FROM PUBLIC;
GRANT EXECUTE ON FUNCTION gdbi.submit_original(jsonb),gdbi.recording_status(jsonb) TO gdbi_gateway_login;
GRANT EXECUTE ON FUNCTION gdbi.claim_recording(jsonb),gdbi.arm_recording(jsonb),gdbi.mark_attention(jsonb),gdbi.dispatch_read(jsonb) TO gdbi_worker_login;
GRANT EXECUTE ON FUNCTION gdbi.create_read(jsonb),gdbi.release_read(jsonb) TO gdbi_reader_login;
GRANT EXECUTE ON FUNCTION gdbi.set_admission(jsonb) TO gdbi_admission_login;
GRANT EXECUTE ON FUNCTION gdbi.request_reconciliation(jsonb) TO gdbi_recovery_login;
GRANT EXECUTE ON FUNCTION gdbi.confirm_source_receipt(jsonb),gdbi.stage_verified_read(jsonb),gdbi.finish_revision(jsonb) TO gdbi_verifier_login;
GRANT EXECUTE ON FUNCTION gdbi.begin_revision(jsonb) TO gdbi_coordinator_login;
GRANT SELECT ON ALL TABLES IN SCHEMA gdbi TO gdbi_backup_login; -- Ciphertext/metadata only; never keys.
RESET ROLE;
-- Runtime logins receive no table DML, ownership, schema CREATE, TEMP or membership
-- in gdbi_owner. Migration login is stored separately and absent from application env.
-- Revocation requires both REVOKE CONNECT/EXECUTE and terminating the dedicated
-- login's existing sessions through the separately authorised administrator.
-- Restore only into a NEW isolated database and reconcile the external witness
-- before permitting any runtime connection. No live restore/rollback is implied.
